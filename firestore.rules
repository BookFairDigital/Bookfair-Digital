rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "SU2kLL2ovwPXGyJ436s8PJpLJQZ2";
    }
    match /students/{uid} {
      allow read, create, update: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isAdmin();
    }
  }
}
